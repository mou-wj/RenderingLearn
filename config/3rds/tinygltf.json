{
  "name": "tinygltf",
  "need_pull": true,
  "git": "https://github.com/syoyo/tinygltf.git",
  "branch": "release",

  "compiler": {
    "windows": {
      "preferred": "msvc",
      "cmake_generator": "Visual Studio 17 2022",
      "cmake_toolset": ""
    },
    "linux": {
      "preferred": "gcc",
      "cmake_generator": "Unix Makefiles",
      "cmake_toolset": ""
    },
    "macos": {
      "preferred": "clang",
      "cmake_generator": "Unix Makefiles",
      "cmake_toolset": ""
    }
  },
  "need_compile": true,
  "type":"static",
  "dependencies": [],

  "cmake": {
    "configure_args": [
      "-DCMAKE_INSTALL_PREFIX=${INSTALL_DIR}/${CONFIG}"
    ],
    "build_targets": ["install"],
    "build_configs": ["Debug","Release"]
  },

  "install_layout": {
    "include": "${INSTALL_DIR}/${CONFIG}/include",
    "lib": "${INSTALL_DIR}/${CONFIG}/lib"
  },


  "notes": "tinygltf is header-only; CMake install will place headers into include/. No static libs expected."
}