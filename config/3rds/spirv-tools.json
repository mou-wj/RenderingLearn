{
  "name": "SPIRV-Tools",
  "ignore": false,
  "type": "remote_source_prebuild",
  "source": {
    "git": "https://github.com/KhronosGroup/SPIRV-Tools.git",
    "branch": "main",
    "extra_repos": [
      {
        "path": "external/spirv-headers",
        "git": "https://github.com/KhronosGroup/SPIRV-Headers.git",
        "branch": "main"
      }
    ]
  },
  "compiler": {
    "windows": {
      "preferred": "msvc",
      "cmake_generator": "Visual Studio 17 2022",
      "cmake_toolset": ""
    },
    "linux": {
      "preferred": "gcc",
      "cmake_generator": "Unix Makefiles",
      "cmake_toolset": ""
    },
    "macos": {
      "preferred": "clang",
      "cmake_generator": "Unix Makefiles",
      "cmake_toolset": ""
    }
  },
  "build_config": {
    "configure_args": [
      "-DCMAKE_INSTALL_PREFIX=${INSTALL_DIR}/spirv-tools/${CONFIG}"
    ],
    "cmake_options": {}
  },
  "install_layout": {
    "root": "${INSTALL_DIR}/spirv-tools/${CONFIG}",
    "include": "include",
    "lib": "lib",
    "bin": "bin"
  },
  "dependencies": [
  ]
}