{
  "name": "glslang",

  "type": "managed",

  "source": {
    "git": "https://github.com/KhronosGroup/glslang.git",
    "branch": "main"
  },

  "compiler": {
    "windows": {
      "preferred": "msvc",
      "cmake_generator": "Visual Studio 17 2022",
      "cmake_toolset": ""
    },
    "linux": {
      "preferred": "gcc",
      "cmake_generator": "Unix Makefiles",
      "cmake_toolset": ""
    },
    "macos": {
      "preferred": "clang",
      "cmake_generator": "Unix Makefiles",
      "cmake_toolset": ""
    }
  },

  "build": {
    "system": "cmake",
    "configure_args": [
      "-DENABLE_OPT=OFF",
      "-DBUILD_EXTERNAL=OFF",
      "-DCMAKE_INSTALL_PREFIX=${INSTALL_DIR}/${CONFIG}"
    ],
    "build_targets": ["install"],
    "configs": ["Debug", "Release"],
    "type" : "static"
  },

  "install_layout": {
    "root": "${INSTALL_DIR}/${CONFIG}",
    "include": "${INSTALL_DIR}/${CONFIG}/include",
    "lib": "${INSTALL_DIR}/${CONFIG}/lib",
    "bin": "${INSTALL_DIR}/${CONFIG}/bin"
  },

  "dependencies": ["SPIRV-Tools", "SPIRV-Headers"],

  "auto_generate_find_cmake": "if_missing",

  "notes": "CMake builds and installs libraries and headers. Prefer Config.cmake if available, otherwise auto-generate FindGLSLANG.cmake."
}