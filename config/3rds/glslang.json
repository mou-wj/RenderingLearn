{
  "name": "glslang",
  "ignore": true,
  "type": "remote_source_prebuild",
  "source": {
    "git": "https://github.com/KhronosGroup/glslang.git",
    "branch": "main"
  },
  "compiler": {
    "windows": {
      "preferred": "msvc",
      "cmake_generator": "Visual Studio 17 2022",
      "cmake_toolset": ""
    },
    "linux": {
      "preferred": "gcc",
      "cmake_generator": "Unix Makefiles",
      "cmake_toolset": ""
    },
    "macos": {
      "preferred": "clang",
      "cmake_generator": "Unix Makefiles",
      "cmake_toolset": ""
    }
  },
  "build_config": {
    "configure_args": [
      "-DCMAKE_INSTALL_PREFIX=${INSTALL_DIR}/glslang/${CONFIG}",
      "-DENABLE_OPT=OFF",
      "-DBUILD_EXTERNAL=OFF",
      "-Dglslang_SHARED=OFF"
    ],
    "cmake_options": {}
  },
  "install_layout": {
    "root": "${INSTALL_DIR}/glslang/${CONFIG}",
    "include": "include",
    "lib": "lib",
    "bin": "bin"
  },
  "dependencies": [
    "SPIRV-Tools"
  ]
}