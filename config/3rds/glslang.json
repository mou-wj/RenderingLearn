{
  "name": "glslang",
  "need_pull": true,
  "git": "https://github.com/KhronosGroup/glslang.git",
  "branch": "main",

  "compiler": {
    "windows": {
      "preferred": "msvc",
      "cmake_generator": "Visual Studio 17 2022",
      "cmake_toolset": ""
    },
    "linux": {
      "preferred": "gcc",
      "cmake_generator": "Unix Makefiles",
      "cmake_toolset": ""
    },
    "macos": {
      "preferred": "clang",
      "cmake_generator": "Unix Makefiles",
      "cmake_toolset": ""
    }
  },
  "need_compile": true,
  "type":"shared",
  "dependencies": ["SPIRV-Tools", "SPIRV-Headers"],

  "cmake": {
    "generator": "default",
    "configure_args": [
      "-DENABLE_OPT=OFF",
      "-DBUILD_EXTERNAL=OFF",
      "-DCMAKE_INSTALL_PREFIX=${INSTALL_DIR}/${CONFIG}"
    ],
    "build_targets": ["install"],
    "build_configs": ["Debug","Release"]
  },

  "install_layout": {
    "include": "${INSTALL_DIR}/${CONFIG}/include",
    "include_extra": "${INSTALL_DIR}/${CONFIG}/include/glslang/Public",
    "lib": "${INSTALL_DIR}/${CONFIG}/lib",
    "bin": "${INSTALL_DIR}/${CONFIG}/bin"
  },


  "notes": "CMake builds and installs libraries and headers. CMake args may be adjusted for platform."
}