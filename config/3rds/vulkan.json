{
  "name": "Vulkan",
  "ignore": false,
  "type": "manual",
  "install_layout": {
    "root": "${ENV:VULKAN_SDK}"
  },
"manual_info": {
    "common_defines": [
      ""
    ],
     "include_dirs": [
        "Include"
     ],
    "components": {
      "vulkan": {
        "lib": {
          "debug": [
            "Lib/vulkan-1"
          ],
          "release": [
            "Lib/vulkan-1"
          ]
        },
        "runtime": {
          "PathMode" : "Absolute",
          "debug": [
            "${SYSTEM_PATH}/vulkan-1"
          ],
          "release": [
            "${SYSTEM_PATH}/vulkan-1"
          ]
        },
        "dependencies": []
      }
    }
  },
  "notes": " Vulkan 为手动配置模式，只需要头文件。脚本应拼接 install_layout.root 与 manual_info 中的相对路径来构建 Target。"
}