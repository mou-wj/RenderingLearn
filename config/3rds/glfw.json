{
  "name": "glfw",

  "type": "managed", 

  "source": {
    "git": "https://github.com/glfw/glfw.git",
    "branch": "master"
  },

  "compiler": {
    "windows": {
      "preferred": "msvc",
      "cmake_generator": "Visual Studio 17 2022",
      "cmake_toolset": ""
    },
    "linux": {
      "preferred": "gcc",
      "cmake_generator": "Unix Makefiles",
      "cmake_toolset": ""
    },
    "macos": {
      "preferred": "clang",
      "cmake_generator": "Unix Makefiles",
      "cmake_toolset": ""
    }
  },

  "build": {
    "system": "cmake",
    "configure_args": [
      "-DCMAKE_INSTALL_PREFIX=${INSTALL_DIR}/${CONFIG}",
      "-DGLFW_BUILD_EXAMPLES=OFF",
      "-DGLFW_BUILD_TESTS=OFF",
      "-DGLFW_BUILD_DOCS=OFF"
    ],
    "build_targets": ["install"],
    "configs": ["Debug", "Release"],
    "type" : "shared"
  },

  "install_layout": {
    "root": "${INSTALL_DIR}/${CONFIG}",
    "include": "${INSTALL_DIR}/${CONFIG}/include",
    "lib": "${INSTALL_DIR}/${CONFIG}/lib",
    "bin": "${INSTALL_DIR}/${CONFIG}/bin"
  },

  "dependencies": [],

  "auto_generate_find_cmake": "if_missing", 

  "notes": "CMake installs headers and library; prefer Config.cmake if available, otherwise auto-generate FindGLFW.cmake."
}