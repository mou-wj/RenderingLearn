{
  "name": "glfw",
  "need_pull": true,
  "git": "https://github.com/glfw/glfw.git",
  "branch": "master",

  "compiler": {
    "windows": {
      "preferred": "msvc",
      "cmake_generator": "Visual Studio 17 2022",
      "cmake_toolset": ""
    },
    "linux": {
      "preferred": "gcc",
      "cmake_generator": "Unix Makefiles",
      "cmake_toolset": ""
    },
    "macos": {
      "preferred": "clang",
      "cmake_generator": "Unix Makefiles",
      "cmake_toolset": ""
    }
  },   
  "need_compile": true,  
  "type":"shared",                           
  "dependencies": [],                

  "cmake": {
    "configure_args": [
      "-DCMAKE_INSTALL_PREFIX=${INSTALL_DIR}/${CONFIG}",
      "-DGLFW_BUILD_EXAMPLES=OFF",
      "-DGLFW_BUILD_TESTS=OFF",
      "-DGLFW_BUILD_DOCS=OFF"
    ],
    "build_targets": ["install"],
    "build_configs": ["Debug","Release"]
  },

  "install_layout": {
    "include": "${INSTALL_DIR}/${CONFIG}/include",
    "lib": "${INSTALL_DIR}/${CONFIG}/lib",
    "bin": "${INSTALL_DIR}/${CONFIG}/bin"
  },


  "notes": "CMake installs headers and library; link glfw3.lib and add include dir to CMake."
}