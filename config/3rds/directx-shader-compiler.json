{
  "name": "directx-shader-compiler",
  "ignore": false,
  "type": "manual",
  "install_layout": {
    "root": "${ENV:VULKAN_SDK}"
  },
"manual_info": {
    "common_defines": [
      ""
    ],
     "include_dirs": [
        "Include"
     ],
    "components": {
      "dxc": {
        "lib": {
          "debug": [
            "Lib/dxcompiler"
          ],
          "release": [
            "Lib/dxcompiler"
          ]
        },
        "runtime": {
          "debug": [
            "Bin/dxcompiler"
          ],
          "release": [
            "Bin/dxcompiler"
          ]
        },
        "dependencies": []
      }
    }
  },
  "notes": " dxcompiler 为手动配置模式，使用vulkan安装路径下的dxcompiler，。脚本应拼接 install_layout.root 与 manual_info 中的相对路径来构建 Target。"
}