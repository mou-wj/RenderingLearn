{
  "name": "directx-shader-compiler",
  "type": "source",
  "config_type": "cmake_config",
  "source_type": "git",
  "build_timing": "pre_build",
  "source": {
    "git": "https://github.com/microsoft/DirectXShaderCompiler.git",
    "branch": "main",
    "extra_repos": [
       {
        "path": "external/DirectX-Headers",
        "git": "https://github.com/microsoft/DirectX-Headers.git",
        "branch": "main"
      },
      {
        "path": "external/SPIRV-Headers",
        "git": "https://github.com/KhronosGroup/SPIRV-Headers.git",
        "branch": "main"
      },
    {
        "path": "external/SPIRV-Tools",
        "git": "https://github.com/KhronosGroup/SPIRV-Tools.git",
        "branch": "main"
      }
    ]
  },
  "compiler": {
    "windows": {
      "preferred": "msvc",
      "cmake_generator": "Visual Studio 17 2022",
      "cmake_toolset": ""
    },
    "linux": {
      "preferred": "gcc",
      "cmake_generator": "Unix Makefiles",
      "cmake_toolset": ""
    },
    "macos": {
      "preferred": "clang",
      "cmake_generator": "Unix Makefiles",
      "cmake_toolset": ""
    }
  },
  "build_config": {
    "configure_args": [
      "-DCMAKE_INSTALL_PREFIX=${INSTALL_DIR}/directx-shader-compiler/${CONFIG}",
      "-DENABLE_OPT=OFF",
      "-DLLVM_TARGETS_TO_BUILD=X86"
    ],
    "cmake_options": {}
  },
  "install_layout": {
    "root": "${INSTALL_DIR}/directx-shader-compiler/${CONFIG}",
    "include": "include",
    "lib": "lib",
    "bin": "bin"
  },
  "dependencies": [
  ]
}