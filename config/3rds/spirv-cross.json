{
  "name": "SPIRV-Cross",

  "type": "managed",

  "source": {
    "git": "https://github.com/KhronosGroup/SPIRV-Cross.git",
    "branch": "main"
  },

  "compiler": {
    "windows": {
      "preferred": "msvc",
      "cmake_generator": "Visual Studio 17 2022",
      "cmake_toolset": ""
    },
    "linux": {
      "preferred": "gcc",
      "cmake_generator": "Unix Makefiles",
      "cmake_toolset": ""
    },
    "macos": {
      "preferred": "clang",
      "cmake_generator": "Unix Makefiles",
      "cmake_toolset": ""
    }
  },

  "build": {
    "system": "cmake",
    "configure_args": [
      "-DCMAKE_INSTALL_PREFIX=${INSTALL_DIR}/${CONFIG}"
    ],
    "build_targets": ["install"],
    "configs": ["Debug", "Release"],
    "type" : "shared"
  },

  "install_layout": {
    "root": "${INSTALL_DIR}/${CONFIG}",
    "include": "${INSTALL_DIR}/${CONFIG}/include/spirv_cross",
    "lib": "${INSTALL_DIR}/${CONFIG}/lib",
    "bin": "${INSTALL_DIR}/${CONFIG}/bin"
  },

  "dependencies": ["SPIRV-Headers"],

  "auto_generate_find_cmake": "if_missing",

  "notes": "CMake install places headers under include/spirv_cross. Prefer Config.cmake if available; otherwise auto-generate FindSPIRV-Cross.cmake."
}