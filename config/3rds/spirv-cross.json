{
  "name": "SPIRV-Cross",
  "need_pull": true,
  "git": "https://github.com/KhronosGroup/SPIRV-Cross.git",
  "branch": "main",

  "compiler": {
    "windows": {
      "preferred": "msvc",
      "cmake_generator": "Visual Studio 17 2022",
      "cmake_toolset": ""
    },
    "linux": {
      "preferred": "gcc",
      "cmake_generator": "Unix Makefiles",
      "cmake_toolset": ""
    },
    "macos": {
      "preferred": "clang",
      "cmake_generator": "Unix Makefiles",
      "cmake_toolset": ""
    }
  },
  "need_compile": true,
  "type":"shared",
  "dependencies": ["SPIRV-Headers"],

  "cmake": {
    "configure_args": [
      "-DCMAKE_INSTALL_PREFIX=${INSTALL_DIR}/${CONFIG}"
    ],
    "build_targets": ["install"],
    "build_configs": ["Debug","Release"]
  },

  "install_layout": {
    "include": "${INSTALL_DIR}/${CONFIG}/include/spirv_cross",
    "lib": "${INSTALL_DIR}/${CONFIG}/lib",
    "bin": "${INSTALL_DIR}/${CONFIG}/bin"
  },

  "notes": "CMake install places headers under include/spirv_cross. Link against required sub-libraries depending on use-case."
}