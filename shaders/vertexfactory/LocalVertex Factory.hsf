/**
 * LocalVertexFactory.ush
 * 移除了 F 前缀，使用阶段流向命名的结构体
 */

// 1. 输入数据 (来自顶点缓冲区)
struct VertexFactoryInput
{
    float4 Position : ATTRIBUTE0;
    float2 TexCoord : ATTRIBUTE1;
    float3 Normal   : ATTRIBUTE2;
    float4 Tangent  : ATTRIBUTE3; // xyz: 切线, w: 手性
};

// 2. 内部计算中间体 (仅 VS 内部使用)
struct VertexFactoryIntermediates
{
    float3 WorldPosition;
    float3x3 TangentToWorld;
    float2 TexCoord;
};

// 3. 核心：从 VS 传往 PS 的插值数据 (VSToPS)
struct VertexFactoryVSToPS
{
    float2 TexCoord       : TEXCOORD0;
    float4 TangentToWorld0 : TANGENT0; // TBN 第1行 + w
    float4 TangentToWorld2 : TANGENT1; // TBN 第3行 (Normal)
};

// --- 接口实现 ---

VertexFactoryIntermediates GetVertexFactoryIntermediates(VertexFactoryInput Input)
{
    VertexFactoryIntermediates Intermediates;
    Intermediates.TexCoord = Input.TexCoord;

    // 假设 Primitive 是你通过 ConstantBuffer 传进来的物体信息
    float4x4 LocalToWorld = Primitive.LocalToWorld;

    Intermediates.WorldPosition = mul(LocalToWorld, float4(Input.Position.xyz, 1.0)).xyz;

    float3 WNormal  = normalize(mul((float3x3)LocalToWorld, Input.Normal));
    float3 WTangent = normalize(mul((float3x3)LocalToWorld, Input.Tangent.xyz));
    // 计算副法线并存储手性
    float3 WBinormal = cross(WNormal, WTangent) * Input.Tangent.w;
    
    Intermediates.TangentToWorld = float3x3(WTangent, WBinormal, WNormal);

    return Intermediates;
}

// 供主 VS 调用：打包插值数据
VertexFactoryVSToPS VertexFactoryGetVSToPS(VertexFactoryInput Input, VertexFactoryIntermediates Intermediates)
{
    VertexFactoryVSToPS Interpolants;
    Interpolants.TexCoord = Intermediates.TexCoord;
    
    // 打包 TBN 到插值器
    Interpolants.TangentToWorld0 = float4(Intermediates.TangentToWorld[0], Input.Tangent.w);
    Interpolants.TangentToWorld2 = float4(Intermediates.TangentToWorld[2], 0.0);
    
    return Interpolants;
}

float4 VertexFactoryGetWorldPosition(VertexFactoryInput Input, VertexFactoryIntermediates Intermediates)
{
    return float4(Intermediates.WorldPosition, 1.0);
}

// 供主 PS 调用：解包法线信息
float3 VertexFactoryGetWorldNormal(VertexFactoryVSToPS Interpolants)
{
    return Interpolants.TangentToWorld2.xyz;
}

float3x3 VertexFactoryGetTangentToWorld(VertexFactoryVSToPS Interpolants)
{
    float3 N = Interpolants.TangentToWorld2.xyz;
    float3 T = Interpolants.TangentToWorld0.xyz;
    float3 B = cross(N, T) * Interpolants.TangentToWorld0.w;
    return float3x3(T, B, N);
}