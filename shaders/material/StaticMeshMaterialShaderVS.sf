#include "/Generated/VertexFactory.sf"

VertexFactoryVSToPS MainVS(VertexFactoryInput Input)
{
    VertexFactoryVSToPS Output;

    VertexFactoryIntermediates Intermediates =
        GetVertexFactoryIntermediates(Input);
    Output = VertexFactoryGetVSToPS(Input,Intermediates);
    return Output;
}

