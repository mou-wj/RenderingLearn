#include "/Generated/VertexFactory.sf"
struct PSInput
{
    float4 Position : SV_Position;            
    VertexFactoryVSToPS FactoryInterpolants; 
};
float4 MainPS(PSInput Input) : SV_Target0
{
    float4 Out;
    float depth = 0;
#if DEPTH_STORE_MODE == 0
    float4 clipPos = Input.FactoryInterpolants.ClipPosition;
    depth = clipPos.z / clipPos.w;
#elif DEPTH_STORE_MODE == 1
    depth = distance(Input.FactoryInterpolants.WorldPosition,CameraWorldPosition);
#endif
    Out.r = depth;
    Out.g = Out.r * Out.r;
    return Out;

}