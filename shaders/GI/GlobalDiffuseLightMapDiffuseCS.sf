#include "/core/ShadingCommon.sf"
#include "/core/SceneParametersHelper.sf"
#include "/Generated/ShaderParameters/SceneVoxelDiffusePropagationParameters.sf"

struct SceneVoxelLeafIrradiance
{
    float3 Irradiance;
    float Weight;
};

static float3 EvaluateHemisphereWeight(float3 N, float3 L)
{
    return max(dot(N, L), 0.0) * float3(1.0, 1.0, 1.0);
}

[numthreads(64, 1, 1)]
void MainCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
    uint voxelIndex = DispatchThreadID.x;
    if (voxelIndex >= VoxelCount)
    {
        return;
    }

    SceneVoxelCell centerVoxel = Voxels[voxelIndex];
    float3 centerPos = (centerVoxel.Bounds.Min + centerVoxel.Bounds.Max) * 0.5;
    float3 centerNormal = normalize(centerVoxel.Normal);

    float3 accumulated = float3(0.0, 0.0, 0.0);
    float totalWeight = 0.0;

    const uint sampleCount = 32u;
    for (uint i = 0; i < sampleCount; ++i)
    {
        float u = float(i) / float(sampleCount);
        float v = fract(float(i) * 0.61803398875);
        float3 dir = normalize(float3(
            cos(2.0 * PI * v) * sqrt(1.0 - u * u),
            u,
            sin(2.0 * PI * v) * sqrt(1.0 - u * u)));

        float ndotl = max(dot(centerNormal, dir), 0.0);
        if (ndotl <= 0.0)
        {
            continue;
        }

        float3 targetPos = centerPos + dir * (VoxelSize * 2.0);

        // Find all voxels inside the hemisphere neighborhood.
        // Implementation is intentionally split into a separate scratch buffer to avoid in-place updates.
        for (uint j = 0; j < VoxelCount; ++j)
        {
            if (j == voxelIndex)
            {
                continue;
            }

            SceneVoxelCell neighbor = Voxels[j];
            float3 neighborPos = (neighbor.Bounds.Min + neighbor.Bounds.Max) * 0.5;
            float dist = length(neighborPos - targetPos);
            if (dist > VoxelSize * 3.0)
            {
                continue;
            }

            float3 neighborNormal = normalize(neighbor.Normal);
            float influence = max(dot(neighborNormal, dir), 0.0);
            if (influence <= 0.0)
            {
                continue;
            }

            float3 contribution = InputDiffuse[j].Irradiance * influence;
            accumulated += contribution;
            totalWeight += influence;
        }
    }

    float3 finalDiffuse = (totalWeight > 0.0) ? (accumulated / totalWeight) : InputDiffuse[voxelIndex].Irradiance;
    DiffusionScratch[voxelIndex].Irradiance = finalDiffuse;
    DiffusionScratch[voxelIndex].Weight = totalWeight;
    OutputDiffuse[voxelIndex].Irradiance = finalDiffuse;
    OutputDiffuse[voxelIndex].Weight = totalWeight;
}
