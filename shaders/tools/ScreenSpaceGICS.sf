#include "/core/ShadingContext.sf"
#define SHADINGMODEL_UNLIT 0
#define SHADINGMODEL_LIT 1
#include "/Generated/ShaderParameters/ScreenSpaceGIParameters.sf"
#include "/core/GBufferParametersHelper.sf"
#include "/Generated/ShaderParameters/GBufferTextureParameters.sf"
#include "/core/ShadingCommon.sf"

float3 ProjectWorldToScreenUVDepth(float3 worldPos)
{
    float4 clipPos = mul(ViewProj, float4(worldPos, 1.0));
    float invW = 1.0 / max(abs(clipPos.w), 1e-6);

    float2 ndc = clipPos.xy * invW;
    float2 uv;
    uv.x = ndc.x * 0.5 + 0.5;
    uv.y = 1.0 - (ndc.y * 0.5 + 0.5);

    float depth = clipPos.z * invW;
    return float3(uv, depth);
}

void BuildBasis(float3 n, out float3 t, out float3 b)
{
    float3 up = abs(n.y) < 0.999 ? float3(0.0, 1.0, 0.0) : float3(1.0, 0.0, 0.0);
    t = normalize(cross(up, n));
    b = cross(n, t);
}

float Hash11(uint seed)
{
    seed = (seed ^ 0x9E3779B9u) * 1664525u + 1013904223u;
    seed ^= seed >> 16;
    seed *= 0x85EBCA6Bu;
    seed ^= seed >> 13;
    seed *= 0xC2B2AE3Du;
    seed ^= seed >> 16;
    return (float(seed) / 4294967295.0);
}


bool IsInsideScreenUV(float2 uv)
{
    return uv.x >= 0.0 && uv.x <= 1.0 && uv.y >= 0.0 && uv.y <= 1.0;
}

float2 ComputeMipUVStep(float2 dirUV, uint mipLevel)
{
    float2 stepUV = normalize(dirUV) * (1.0 / pow(2.0, (float)mipLevel));
    float minStep = min(abs(stepUV.x), abs(stepUV.y));
    if (abs(stepUV.x) > abs(stepUV.y))
    {
        stepUV.x = sign(stepUV.x) * minStep;
    }
    else if (abs(stepUV.y) > abs(stepUV.x))
    {
        stepUV.y = sign(stepUV.y) * minStep;
    }
    return stepUV;
}

float2 ProjectRayUVToScreen(float3 rayOrigin, float3 rayDir, float2 startUV, float2 dirUV, float2 uv)
{
    float2 uvDelta = uv - startUV;
    float rayT = length(uvDelta) / max(length(dirUV), 1e-4) * MaxTraceDistance;
    float3 samplePos = rayOrigin + rayDir * rayT;
    return ProjectWorldToScreenUVDepth(samplePos).xy;
}

bool IsPossibleHiZHit(float rayDepth, float minDepth, uint mipLevel)
{
    return rayDepth >= minDepth;
}

bool IsFinalDepthHit(float rayDepth, float sceneDepth)
{
    const float finalHitEpsilon = 0.0005;
    float delta = rayDepth - sceneDepth;
    if(delta >= 0 && delta < finalHitEpsilon){
        return true;
    }
    return false;
}

bool TraceScreenSpaceRayStep(float3 rayOrigin, float3 rayDir, float2 startUV, float2 dirUV, uint mipLevel, inout float2 currentUV, out float2 hitUV)
{
    hitUV = currentUV;

    float2 stepUV = ComputeMipUVStep(dirUV, mipLevel);
    float2 nextUV = currentUV + stepUV;
    if (!IsInsideScreenUV(nextUV))
    {
        currentUV = nextUV;
        return false;
    }

    float2 sampleUV = ProjectRayUVToScreen(rayOrigin, rayDir, startUV, dirUV, nextUV);
    if (!IsInsideScreenUV(sampleUV))
    {
        currentUV = nextUV;
        return false;
    }

    float sceneDepth = Depth.SampleLevel(PointSampler, sampleUV, mipLevel).r;
    float rayDepth = ProjectWorldToScreenUVDepth(rayOrigin + rayDir * (length(nextUV - startUV) / max(length(dirUV), 1e-4) * MaxTraceDistance)).z;

    if (mipLevel == 0u)
    {
        if (IsFinalDepthHit(rayDepth, sceneDepth))
        {
            currentUV = sampleUV;
            hitUV = sampleUV;
            return true;
        }
    }
    else
    {
        if (IsPossibleHiZHit(rayDepth, sceneDepth, mipLevel))
        {
            currentUV = sampleUV;
            hitUV = sampleUV;
            return true;
        }
    }

    currentUV = nextUV;
    return false;
}

bool TraceScreenSpaceRay(float3 rayOrigin, float3 rayDir, out float2 hitUV)
{
    hitUV = 0.0;

    float2 startUV = ProjectWorldToScreenUVDepth(rayOrigin).xy;
    if (!IsInsideScreenUV(startUV))
    {
        return false;
    }

    float3 farPos = rayOrigin + rayDir * MaxTraceDistance;
    float2 farUV = ProjectWorldToScreenUVDepth(farPos).xy;
    float2 dirUV = farUV - startUV;
    if (length(dirUV) < 1e-4)
    {
        return false;
    }
    dirUV = normalize(dirUV);

    const uint maxMipLevel = 6u;
    float2 currentUV = startUV;
    float2 candidateUV = startUV;
    bool foundCandidate = false;

    [loop]
    for (uint mipLevel = maxMipLevel; mipLevel > 0u; --mipLevel)
    {
        currentUV = candidateUV;
        foundCandidate = false;

        [loop]
        for (uint traceIter = 0u; traceIter < 256u; ++traceIter)
        {
            if (!IsInsideScreenUV(currentUV))
            {
                break;
            }

            float2 stepHitUV;
            if (TraceScreenSpaceRayStep(rayOrigin, rayDir, startUV, dirUV, mipLevel, currentUV, stepHitUV))
            {
                foundCandidate = true;
                candidateUV = stepHitUV;
                break;
            }
        }

        if (foundCandidate)
        {
            continue;
        }
    }

    if (!foundCandidate)
    {
        return false;
    }

    currentUV = candidateUV;
    [loop]
    for (uint traceIter = 0u; traceIter < 256u; ++traceIter)
    {
        if (!IsInsideScreenUV(currentUV))
        {
            break;
        }

        float2 stepHitUV;
        if (TraceScreenSpaceRayStep(rayOrigin, rayDir, startUV, dirUV, 0u, currentUV, stepHitUV))
        {
            hitUV = stepHitUV;
            return true;
        }
    }

    return false;
}

float3 ScreenSpaceDiffuseGI(float3 worldPos, float3 normal, float2 uv, float3 albedo)
{
    float3 accum = 0.0;
    float totalWeight = 0.0;
    float3 tangent;
    float3 bitangent;
    BuildBasis(normal, tangent, bitangent);

    const uint diffuseSampleCount = 20u;
    const float hemisphereRadius = 0.45;
    bool hit = false;
    [loop]
    for (uint i = 0u; i < diffuseSampleCount; ++i)
    {
        float u0 = Hash11((uint)(uv.x * 1000.0) + i * 37u + 1u);
        float u1 = Hash11((uint)(uv.y * 1000.0) + i * 91u + 17u);

        float phi = 2.0 * PI * u0;
        float cosTheta = sqrt(max(0.0, 1.0 - u1));
        float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));

        float3 localDir = float3(cos(phi) * sinTheta, sin(phi) * sinTheta, cosTheta);
        float3 sampleDir = normalize(tangent * localDir.x + bitangent * localDir.y + normal * localDir.z);
        float3 viewDir = normalize(CameraPos - worldPos);
        if (dot(sampleDir, viewDir) >= 0.0)
        {
            continue;
        }

        float3 rayOrigin = worldPos + normal * 0.04;
        float2 traceHitUV = 0.0;
        if (!TraceScreenSpaceRay(rayOrigin, sampleDir, traceHitUV))
        {
            continue;
        }
        hit = true;
        float weight = saturate(dot(sampleDir, normal));
        float3 incidentLight = SceneColorTexture.SampleLevel(PointSampler, traceHitUV, 0.0).rgb;
        accum += incidentLight * weight;
        totalWeight += weight;
    }
    if(hit){
        //return float3(0,1,0);
    }
    if (totalWeight <= 1e-4)
    {
        return 0.0;
    }

    float3 diffuse = accum / totalWeight;
    return diffuse * albedo * 0.75;
}


float3 ScreenSpaceSpecularReflection(float3 worldPos, float3 normal, float3 viewDir, float2 uv, float roughness)
{
    float3 reflectDir = normalize(reflect(-viewDir, normal));
    float3 rayOrigin = worldPos + normal * 0.04;
    float2 hitUV = 0.0;

    float rayForward = dot(normalize(reflectDir), normalize(viewDir));
    if (rayForward >= 0.0)
    {
        return 0.0;
    }
    if (!TraceScreenSpaceRay(rayOrigin, reflectDir, hitUV))
    {
        return 0.0;
    }

    float fresnel = pow(1.0 - saturate(dot(normal, viewDir)), 5.0);
    float weight = (1.0 - roughness) * (0.04 + 0.96 * fresnel);
    float3 hitColor = SceneColorTexture.SampleLevel(PointSampler, hitUV, 0.0).rgb;
    return hitColor;
}

[numthreads(8,8,1)]
void MainCS(uint3 DTid : SV_DispatchThreadID)
{
    uint2 PixelPos = DTid.xy;
    float2 UV = (PixelPos + 0.5) / ScreenSize;

    if (PixelPos.x >= uint(ScreenSize.x) || PixelPos.y >= uint(ScreenSize.y))
    {
        return;
    }

    ShadingContext Context;
    MaterialData Material = ReconstructMaterialData(UV);
    uint ShadingModelId = GetShadingModelId(UV);


    Context.WorldPosition = ReconstructWorldPosition(UV,InvViewProj);
    Context.CameraPosition = CameraPos;
    float3 viewDir = normalize(CameraPos - Context.WorldPosition);
    Context.ViewDirection = viewDir;


    float3 baseColor = Material.BaseColor.rgb;
    float3 N = normalize(Material.NormalTS);
    
    float3 V = normalize(Context.ViewDirection);
    
    float3 R = reflect(-V,N);
    float roughness = Material.Roughness;
    float3 sceneColor = SceneColorTexture.SampleLevel(PointSampler, UV, 0.0).rgb;

    float3 worldPos =  Context.WorldPosition;
    float3 diffuseGI = 0.0;
    float3 specularGI = 0.0;

    if (ShadingModelId == SHADINGMODEL_LIT)
    {
        diffuseGI = ScreenSpaceDiffuseGI(worldPos, N, UV, baseColor);
        specularGI = ScreenSpaceSpecularReflection(worldPos, N, V, UV, roughness);
    }
    else
    {
        diffuseGI = 0.0;
        specularGI = 0.0;
    }

    float3 outColor = sceneColor + diffuseGI + specularGI;
    OutputGIColor[PixelPos] = float4(outColor, 1.0);
}