#include "/core/ShadingContext.sf"
#define SHADINGMODEL_UNLIT 0
#define SHADINGMODEL_LIT 1
#include "/Generated/ShaderParameters/ScreenSpaceGIParameters.sf"
#include "/core/GBufferParametersHelper.sf"
#include "/Generated/ShaderParameters/GBufferTextureParameters.sf"
#include "/core/ShadingCommon.sf"

float3 ProjectWorldToScreenUVDepth(float3 worldPos)
{
    float4 clipPos = mul(ViewProj, float4(worldPos, 1.0));
    float invW = 1.0 / max(abs(clipPos.w), 1e-6);

    float2 ndc = clipPos.xy * invW;
    float2 uv;
    uv.x = ndc.x * 0.5 + 0.5;
    uv.y = 1.0 - (ndc.y * 0.5 + 0.5);

    float depth = clipPos.z * invW;
    return float3(uv, depth);
}

void BuildBasis(float3 n, out float3 t, out float3 b)
{
    float3 up = abs(n.y) < 0.999 ? float3(0.0, 1.0, 0.0) : float3(1.0, 0.0, 0.0);
    t = normalize(cross(up, n));
    b = cross(n, t);
}

float Hash11(uint seed)
{
    seed = (seed ^ 0x9E3779B9u) * 1664525u + 1013904223u;
    seed ^= seed >> 16;
    seed *= 0x85EBCA6Bu;
    seed ^= seed >> 13;
    seed *= 0xC2B2AE3Du;
    seed ^= seed >> 16;
    return (float(seed) / 4294967295.0);
}

float3 ScreenSpaceDiffuseGI(float3 worldPos, float3 normal, float2 uv, float3 albedo)
{
    float3 accum = 0.0;
    float totalWeight = 0.0;
    float3 tangent;
    float3 bitangent;
    BuildBasis(normal, tangent, bitangent);

    const uint diffuseSampleCount = 20u;
    const float hemisphereRadius = 0.45;

    [loop]
    for (uint i = 0u; i < diffuseSampleCount; ++i)
    {
        float u0 = Hash11((uint)(uv.x * 1000.0) + i * 37u + 1u);
        float u1 = Hash11((uint)(uv.y * 1000.0) + i * 91u + 17u);

        float phi = 2.0 * PI * u0;
        float cosTheta = sqrt(max(0.0, 1.0 - u1));
        float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));

        float3 localDir = float3(cos(phi) * sinTheta, sin(phi) * sinTheta, cosTheta);
        float3 sampleDir = normalize(tangent * localDir.x + bitangent * localDir.y + normal * localDir.z);
        float3 samplePos = worldPos + sampleDir * hemisphereRadius;

        float3 projected = ProjectWorldToScreenUVDepth(samplePos);
        float2 sampleUV = projected.xy;

        if (sampleUV.x < 0.0 || sampleUV.x > 1.0 || sampleUV.y < 0.0 || sampleUV.y > 1.0)
        {
            continue;
        }

        float sceneDepth = Depth.SampleLevel(PointSampler, sampleUV, 0.0).r;
        float relation = abs(projected.z - sceneDepth);

        if (relation < TraceThickness)
        {
            float weight = saturate(dot(sampleDir, normal));
            float3 sampleColor = SceneColorTexture.SampleLevel(PointSampler, sampleUV, 0.0).rgb;
            accum += sampleColor * weight;
            totalWeight += weight;
        }
    }

    if (totalWeight <= 1e-4)
    {
        return 0.0;
    }

    float3 diffuse = accum / totalWeight;
    return diffuse * albedo * 0.75;
}

float3 ScreenSpaceSpecularReflection(float3 worldPos, float3 normal, float3 viewDir, float2 uv, float roughness)
{
    float3 reflectDir = normalize(reflect(-viewDir, normal));
    float3 rayOrigin = worldPos + normal * 0.04;

    const float maxDist = max(MaxTraceDistance, 0.1);
    const float stepStride = maxDist / max((float)MaxTraceSteps, 1.0);

    [loop]
    for (uint stepIndex = 0u; stepIndex < MaxTraceSteps; ++stepIndex)
    {
        float t = ((float)stepIndex + 1.0) * stepStride;
        float3 samplePos = rayOrigin + reflectDir * t;

        float3 projected = ProjectWorldToScreenUVDepth(samplePos);
        float2 sampleUV = projected.xy;

        if (sampleUV.x < 0.0 || sampleUV.x > 1.0 || sampleUV.y < 0.0 || sampleUV.y > 1.0)
        {
            break;
        }

        float mipLevel = clamp(log2(1.0 + (float)stepIndex * 0.6), 0.0, 10.0);
        float sceneDepth = Depth.SampleLevel(PointSampler, sampleUV, mipLevel).r;
        float rayDepth = projected.z;

        if (abs(rayDepth - sceneDepth) < TraceThickness)
        {
            float fresnel = pow(1.0 - saturate(dot(normal, viewDir)), 5.0);
            float weight = (1.0 - roughness) * (0.04 + 0.96 * fresnel);
            float3 hitColor = SceneColorTexture.SampleLevel(PointSampler, sampleUV, 0.0).rgb;
            return hitColor * weight;
        }
    }

    return 0.0;
}

[numthreads(8,8,1)]
void MainCS(uint3 DTid : SV_DispatchThreadID)
{
    uint2 PixelPos = DTid.xy;
    float2 UV = (PixelPos + 0.5) / ScreenSize;

    if (PixelPos.x >= uint(ScreenSize.x) || PixelPos.y >= uint(ScreenSize.y))
    {
        return;
    }

    ShadingContext Context;
    MaterialData Material = ReconstructMaterialData(UV);
    uint ShadingModelId = GetShadingModelId(UV);


    Context.WorldPosition = ReconstructWorldPosition(UV,InvViewProj);
    Context.CameraPosition = CameraPos;
    float3 viewDir = normalize(CameraPos - Context.WorldPosition);
    Context.ViewDirection = viewDir;


    float3 baseColor = Material.BaseColor.rgb;
    float3 N = normalize(Material.NormalTS);
    
    float3 V = normalize(Context.ViewDirection);
    
    float3 R = reflect(-V,N);
    float roughness = Material.Roughness;
    float3 sceneColor = SceneColorTexture.SampleLevel(PointSampler, UV, 0.0).rgb;

    float3 worldPos =  Context.WorldPosition;
    float3 diffuseGI = 0.0;
    float3 specularGI = 0.0;

    if (ShadingModelId == SHADINGMODEL_LIT)
    {
        diffuseGI = ScreenSpaceDiffuseGI(worldPos, N, UV, baseColor);
        specularGI = ScreenSpaceSpecularReflection(worldPos, N, V, UV, roughness);
    }
    else
    {
        diffuseGI = 0.0;
        specularGI = 0.0;
    }

    float3 outColor = sceneColor + diffuseGI + specularGI;
    OutputGIColor[PixelPos] = float4(outColor, 1.0);
}