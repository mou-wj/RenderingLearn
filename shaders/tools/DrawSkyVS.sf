struct FVertexInput
{
    float3 Position : POSITION;
};

struct FVertexOutput
{
    float4 Position : SV_Position;
    float3 Direction : TEXCOORD0;
};
#include "/Generated/ShaderParameters/DrawSkyVertexParameters.sf"


FVertexOutput MainVS(
    FVertexInput Input)
{
    FVertexOutput Out;

    //-----------------------------------
    // remove translation
    //-----------------------------------

    float4x4 ViewNoTranslation =
        View;

    ViewNoTranslation[0][3] = 0;
    ViewNoTranslation[1][3] = 0;
    ViewNoTranslation[2][3] = 0;
    //-----------------------------------
    // direction for cubemap sampling
    //-----------------------------------

    Out.Direction =
        Input.Position;

    //-----------------------------------
    // project cube
    //-----------------------------------

    float4 Pos =
        mul(
            Projection,
            mul(
                ViewNoTranslation,
                float4(
                    Input.Position,
                    1.0)));

    //-----------------------------------
    // push to far plane
    //-----------------------------------

    Out.Position =
        Pos.xyww;

    return Out;
}
