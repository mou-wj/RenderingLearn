#include "/core/ShadingCommon.sf"

// ============================================================================
// IBL 预计算：环境光贴图与 BRDF LUT
// ============================================================================

#define PI 3.14159265359
#include "/Generated/ShaderParameters/IBLPrecomputeParameters.sf"
#if IBL_PRECOMPUTE_MODE == 0 || IBL_PRECOMPUTE_MODE == 1
#include "/Generated/ShaderParameters/IBLPrecomputeEvnParameters.sf"
#endif 
#if IBL_PRECOMPUTE_MODE == 0
#include "/Generated/ShaderParameters/IBLPrecomputeSpecEvnParameters.sf"
#elif IBL_PRECOMPUTE_MODE == 1
#include "/Generated/ShaderParameters/IBLPrecomputeDiffuseEvnParameters.sf"
#elif IBL_PRECOMPUTE_MODE == 2
#include "/Generated/ShaderParameters/IBLPrecomputeBRDFParameters.sf"
#endif


// ============================================================================
// 常用数学辅助
// ============================================================================

float RadicalInverse_VdC(uint bits)
{
    bits = (bits << 16) | (bits >> 16);
    bits = ((bits & 0x55555555u) << 1) | ((bits & 0xAAAAAAAAu) >> 1);
    bits = ((bits & 0x33333333u) << 2) | ((bits & 0xCCCCCCCCu) >> 2);
    bits = ((bits & 0x0F0F0F0Fu) << 4) | ((bits & 0xF0F0F0F0u) >> 4);
    bits = ((bits & 0x00FF00FFu) << 8) | ((bits & 0xFF00FF00u) >> 8);
    return float(bits) * 2.3283064365386963e-10; // 1/2^32
}

float2 Hammersley(uint i, uint N)
{
    return float2(float(i) / float(N), RadicalInverse_VdC(i));
}

float3 ImportanceSampleGGX(float2 Xi, float roughness, float3 N)
{
    float a = roughness * roughness;
    float phi = 2.0 * PI * Xi.x;
    float cosTheta = sqrt(max(0.0, (1.0 - Xi.y) / (1.0 + (a * a - 1.0) * Xi.y)));
    float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));

    float3 H;
    H.x = sinTheta * cos(phi);
    H.y = sinTheta * sin(phi);
    H.z = cosTheta;

    float3 up = abs(N.z) < 0.999 ? float3(0.0, 0.0, 1.0) : float3(1.0, 0.0, 0.0);
    float3 tangent = normalize(cross(up, N));
    float3 bitangent = cross(N, tangent);

    return normalize(tangent * H.x + bitangent * H.y + N * H.z);
}



float3 EquirectangularUVToDirection(float2 uv)
{
    float phi = uv.x * 2.0 * PI;
    float theta = uv.y * PI;
    float sinTheta = sin(theta);
    return normalize(float3(sinTheta * cos(phi), cos(theta), sinTheta * sin(phi)));
}

float IBLGeometrySchlickGGX(float NdotV, float roughness)
{
    float a = roughness;
    float k = (a * a) * 0.5;

    return NdotV /
        (NdotV * (1.0 - k) + k);
}

float GeometrySmith(float NdotV, float NdotL, float roughness)
{
    float ggxV =
        IBLGeometrySchlickGGX(
            NdotV,
            roughness);

    float ggxL =
        IBLGeometrySchlickGGX(
            NdotL,
            roughness);

    return ggxV * ggxL;
}

float2 IntegrateBRDF(float NdotV, float roughness)
{
    float3 V = float3(sqrt(1.0 - NdotV * NdotV), 0.0, NdotV);
    float A = 0.0;
    float B = 0.0;
    const uint SAMPLE_COUNT = 128u;

    for (uint i = 0u; i < SAMPLE_COUNT; ++i)
    {
        float2 Xi = Hammersley(i, SAMPLE_COUNT);
        float3 H = ImportanceSampleGGX(Xi, roughness, float3(0.0, 0.0, 1.0));
        float3 L = normalize(2.0 * dot(V, H) * H - V);

        float NdotL = saturate(L.z);
        float NdotH = saturate(H.z);
        float VdotH = saturate(dot(V, H));

        if (NdotL > 0.0)
        {
            float G = GeometrySmith(NdotV, NdotL, roughness);
            float G_Vis = (G * VdotH) / (NdotH * NdotV);
            float Fc = pow(1.0 - VdotH, 5.0);
            A += (1.0 - Fc) * G_Vis;
            B += Fc * G_Vis;
        }
    }

    return float2(A / float(SAMPLE_COUNT), B / float(SAMPLE_COUNT));
}

float3 CubemapFaceToDirection(
    uint face,
    float2 uv)
{
    // [0,1] -> [-1,1]
    float2 st = uv * 2.0 - 1.0;

    // HLSL / Vulkan 常见需要翻转 Y
    st.y = -st.y;

    switch (face)
    {
        // +X
        case 0:
            return normalize(
                float3(
                    1.0,
                    st.y,
                    -st.x));

        // -X
        case 1:
            return normalize(
                float3(
                    -1.0,
                    st.y,
                    st.x));

        // +Y
        case 2:
            return normalize(
                float3(
                    st.x,
                    1.0,
                    -st.y));

        // -Y
        case 3:
            return normalize(
                float3(
                    st.x,
                    -1.0,
                    st.y));

        // +Z
        case 4:
            return normalize(
                float3(
                    st.x,
                    st.y,
                    1.0));

        // -Z
        default:
            return normalize(
                float3(
                    -st.x,
                    st.y,
                    -1.0));
    }
}

#if IBL_PRECOMPUTE_MODE == 0 || IBL_PRECOMPUTE_MODE == 1
float3 SampleEquirectangularEnvMap(float3 dir)
{
    float2 uv;
    uv.x = atan2(dir.z, dir.x) / (2.0 * PI) + 0.5;
    uv.y = acos(saturate(dir.y)) / PI;
    return EnvironmentMap.SampleLevel(EnvSampler, uv, 0.0).rgb;
}
#endif

#if IBL_PRECOMPUTE_MODE == 0
float3 PrefilterEnvironment(float3 R, float roughness, int sampleCount)
{
    float3 N = R;
    float3 V = R;
    float3 prefilteredColor = float3(0.0, 0.0, 0.0);
    float totalWeight = 0.0;

    for (int i = 0; i < sampleCount; ++i)
    {
        float2 Xi = Hammersley(uint(i), uint(sampleCount));
        float3 H = ImportanceSampleGGX(Xi, roughness, N);
        float3 L = normalize(2.0 * dot(R, H) * H - R);

        float NdotL = saturate(dot(N, L));
        if (NdotL > 0.0)
        {
            float3 sampleColor = SampleEquirectangularEnvMap(L);
            prefilteredColor += sampleColor * NdotL;
            totalWeight += NdotL;
        }
    }

    return prefilteredColor / max(totalWeight, 1e-5);
}

#elif IBL_PRECOMPUTE_MODE == 1

float3 ImportanceSampleCosineHemisphere(float2 Xi, float3 N)
{
    float phi = 2.0 * PI * Xi.x;
    float cosTheta = sqrt(max(0.0, 1.0 - Xi.y));
    float sinTheta = sqrt(max(0.0, Xi.y));

    float3 H;
    H.x = sinTheta * cos(phi);
    H.y = sinTheta * sin(phi);
    H.z = cosTheta;

    float3 up = abs(N.z) < 0.999 ? float3(0.0, 0.0, 1.0) : float3(1.0, 0.0, 0.0);
    float3 tangent = normalize(cross(up, N));
    float3 bitangent = cross(N, tangent);

    return normalize(tangent * H.x + bitangent * H.y + N * H.z);
}

float3 PrefilterDiffuseEnvironment(float3 N, int sampleCount)
{
    float3 irradiance = float3(0.0, 0.0, 0.0);

    for (int i = 0; i < sampleCount; ++i)
    {
        float2 Xi = Hammersley(uint(i), uint(sampleCount));
        float3 L = ImportanceSampleCosineHemisphere(Xi, N);
        float NdotL = saturate(dot(N, L));
        if (NdotL > 0.0)
        {
            float3 sampleColor = SampleEquirectangularEnvMap(L);
            irradiance += sampleColor * NdotL;
        }
    }

    return irradiance * (PI / float(sampleCount));
}
#endif

// ============================================================================
// 计算入口
// ============================================================================

[numthreads(16, 16, 1)]
void MainCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
#if IBL_PRECOMPUTE_MODE == 0 || IBL_PRECOMPUTE_MODE == 1
     uint2 pix = DispatchThreadID.xy;
    uint face = DispatchThreadID.z;

    // 当前 mip 的尺寸
    if (pix.x >= uint(OutputSize.x) ||
        pix.y >= uint(OutputSize.y))
    {
        return;
    }

    // 当前 cubemap face 的 uv
    float2 uv =
        (float2(pix) + 0.5) /
        float2(OutputSize);

    // cubemap face -> direction
    float3 R =
        CubemapFaceToDirection(
            face,
            uv);


#endif
#if IBL_PRECOMPUTE_MODE == 0
    // 当前 mip 对应 roughness
    float roughness = Roughness;
    // Specular prefilter
    float3 specularColor =
        PrefilterEnvironment(
            R,
            roughness,
            256);

    OutputSpecularTexture[
        uint3(
            pix.x,
            pix.y,
            face)
    ] = float4(
        specularColor,
        1.0);

#elif IBL_PRECOMPUTE_MODE == 1
     
        float3 diffuseColor =
            PrefilterDiffuseEnvironment(
                R,
                256);

        OutputDiffuseTexture[
            uint3(
                pix.x,
                pix.y,
                face)
        ] = float4(
            diffuseColor,
            1.0);
#elif IBL_PRECOMPUTE_MODE == 2
    uint2 pix = DispatchThreadID.xy;
    if (pix.x >= uint(OutputSize.x) || pix.y >= uint(OutputSize.y))
        return;

    float2 uv = (float2(pix) + 0.5) / float2(OutputSize);
    float NdotV = uv.x;
    float roughness = uv.y;
    OutputBRDFLUT[pix] = IntegrateBRDF(NdotV, roughness);
#endif
}
