#include "/Generated/ShaderParameters/DrawSkyPixelParameters.sf"

struct FVertexOutput
{
    float4 Position : SV_Position;
    float3 Direction : TEXCOORD0;
};

float4 MainPS(
    FVertexOutput Input)
    : SV_Target
{
    float3 Direction =
        normalize(
            Input.Direction);

    float3 SkyColor =
        SkyCubemap.Sample(
            SkySampler,
            Direction).rgb;

    return float4(
        SkyColor,
        1.0);
}