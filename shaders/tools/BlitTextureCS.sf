// #define COLOR_CONVERSION_MODE  1
// 0: None, 1: sRGBToLinear, 2: LinearToSRGB
#include "/Generated/ShaderParameters/BlitTextureParameters.sf"

float3 ApplySRGB(float3 c)
{
    return lerp(
        c * 12.92,
        1.055 * pow(c, 1.0 / 2.4) - 0.055,
        step(0.0031308, c)
    );
}

float3 RemoveSRGB(float3 c)
{
    return lerp(
        c / 12.92,
        pow((c + 0.055) / 1.055, 2.4),
        step(0.04045, c)
    );
}

[numthreads(8, 8, 1)]
void MainCS(uint3 DTid : SV_DispatchThreadID)
{
    uint2 DstDim = uint2((uint)DstSize.x, (uint)DstSize.y);

    if (DTid.x >= DstDim.x || DTid.y >= DstDim.y)
        return;

    float2 UV = (float2(DTid.xy) + 0.5f) / DstSize;

    float4 OutColor = SrcTexture.SampleLevel(SrcSampler, UV, SrcMipLevel);

#if COLOR_CONVERSION_MODE == 1
    OutColor.rgb = RemoveSRGB(OutColor.rgb);
#elif COLOR_CONVERSION_MODE == 2
    OutColor.rgb = ApplySRGB(OutColor.rgb);
#endif

    DstTexture[DTid.xy] = OutColor;
}