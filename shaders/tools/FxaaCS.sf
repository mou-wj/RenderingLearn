#include "/Generated/ShaderParameters/FxaaParameters.sf"

float GetLuma(float3 color)
{
    return dot(color, float3(0.299f, 0.587f, 0.114f));
}

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
    uint2 pix = DispatchThreadID.xy;
    uint2 dim = uint2((uint)Resolution.x, (uint)Resolution.y);

    if (pix.x >= dim.x || pix.y >= dim.y)
    {
        return;
    }

    int2 p = int2(pix);
    int2 pL = int2(max(p.x - 1, 0), p.y);
    int2 pR = int2(min(p.x + 1, int(dim.x) - 1), p.y);
    int2 pU = int2(p.x, max(p.y - 1, 0));
    int2 pD = int2(p.x, min(p.y + 1, int(dim.y) - 1));

    float3 c = InputColor.Load(int3(p, 0)).rgb;
    float3 cL = InputColor.Load(int3(pL, 0)).rgb;
    float3 cR = InputColor.Load(int3(pR, 0)).rgb;
    float3 cU = InputColor.Load(int3(pU, 0)).rgb;
    float3 cD = InputColor.Load(int3(pD, 0)).rgb;

    float lumaC = GetLuma(c);
    float lumaL = GetLuma(cL);
    float lumaR = GetLuma(cR);
    float lumaU = GetLuma(cU);
    float lumaD = GetLuma(cD);

    float minLuma = min(lumaC, min(min(lumaL, lumaR), min(lumaU, lumaD)));
    float maxLuma = max(lumaC, max(max(lumaL, lumaR), max(lumaU, lumaD)));
    float contrast = maxLuma - minLuma;

    float edgeThreshold = max(0.0312f, maxLuma * 0.125f);

    float3 outColor = c;
    if (contrast > edgeThreshold)
    {
        float horizontalEdge = abs(lumaL - lumaR);
        float verticalEdge = abs(lumaU - lumaD);

        if (horizontalEdge >= verticalEdge)
        {
            outColor = 0.5f * (cL + cR);
        }
        else
        {
            outColor = 0.5f * (cU + cD);
        }

        outColor = lerp(c, outColor, 0.75f);
    }

    OutputColor[pix] = float4(outColor, 1.0f);
}
