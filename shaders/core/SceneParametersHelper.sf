#include "/core/ShadingCommon.sf"
#include "/Generated/ShaderParameters/SceneShaderParameters.sf"
#include "/Generated/ShaderParameters/SceneLightParameters.sf"
#include "/core/ShadowParametersHelper.sf"
#if DISTANCE_FIELD


#endif



// ============================================================================
// Conversion Helpers
// Scene -> Generic Light
// ============================================================================

DirectionalLight
MakeDirectionalLight(
    DirectionalLightData Data)
{
    DirectionalLight Light;

    Light.Color =
        Data.Color;

    Light.Intensity =
        Data.Intensity;

    Light.Direction =
        normalize(
            Data.Direction);

    return Light;
}


PointLight
MakePointLight(
    PointLightData Data)
{
    PointLight Light;

    Light.Color =
        Data.Color;

    Light.Intensity =
        Data.Intensity;

    Light.Position =
        Data.Position;

    Light.Radius =
        Data.Radius;

    return Light;
}


SpotLight
MakeSpotLight(
    SpotLightData Data)
{
    SpotLight Light;

    Light.Color =
        Data.Color;

    Light.Intensity =
        Data.Intensity;

    Light.Position =
        Data.Position;

    Light.Radius =
        Data.Radius;

    Light.Direction =
        normalize(
            Data.Direction);

    Light.InnerConeCos =
        Data.InnerConeCos;

    Light.OuterConeCos =
        Data.OuterConeCos;

    return Light;
}



// ============================================================================
// Scene Lighting Evaluation
// ============================================================================

float3 EvaluateSceneLighting(
    ShadingContext Context,
    MaterialData Material)
{
    float3 Result = 0;

    // =====================================================
    // Directional
    // =====================================================

    [loop]
    for (uint i = 0;
         i < DirectionalLightCount;
         ++i)
    {
        DirectionalLightData Raw =
            DirectionalLights[i];

        DirectionalLight Light =
            MakeDirectionalLight(
                Raw);
        float3 LightShading =
            ShadeDirectionalLight(
                Context,
                Material,
                Light);
        uint lightId = Raw.LightId;
        float d = distance(Context.WorldPosition,Context.CameraPosition);
        float visibility = ComputeDirectionalShadow(
            lightId,
            Context.WorldPosition,
            d);
        Result +=LightShading * visibility;

    }


    // =====================================================
    // Point
    // =====================================================

    [loop]
    for (uint i = 0;
         i < PointLightCount;
         ++i)
    {
        PointLightData Raw =
            PointLights[i];

        PointLight Light =
            MakePointLight(
                Raw);
        uint lightId = Raw.LightId;
        float visibility = ComputePointShadow(
        lightId,
        Context.WorldPosition,
        Light.Position,
        Light.Radius);
        float3 LightShading =
            ShadePointLight(
                Context,
                Material,
                Light);
        Result += LightShading * visibility;

    }
    

    // =====================================================
    // Spot
    // =====================================================

    [loop]
    for (uint i = 0;
         i < SpotLightCount;
         ++i)
    {
        SpotLightData Raw =
            SpotLights[i];

        SpotLight Light =
            MakeSpotLight(
                Raw);
        float3 LightShading =
            ShadeSpotLight(
                Context,
                Material,
                Light);
        uint lightId = Raw.LightId;
        float visibility = ComputeSpotShadow(
        lightId,
        Context.WorldPosition);
        Result += LightShading * visibility;

    }
    //return Result;
    // =====================================================
    // IBL
    // =====================================================

    {
        float3 N =
            normalize(
                Material.NormalTS);

        float3 V =
            normalize(
                Context.ViewDirection);

        float3 R =
            reflect(
                -V,
                N);

        float NdotV =
            saturate(
                dot(N, V));

        //---------------------------------
        // Sample diffuse irradiance
        //---------------------------------

        float3 DiffuseIrradiance =
            IBLDiffuseMap.Sample(
                LinearClampSampler,
                N).rgb;

        //---------------------------------
        // Sample prefiltered specular
        //---------------------------------

        uint Width;
        uint Height;
        uint MipCount;

        IBLSpecularMap.GetDimensions(
            0,
            Width,
            Height,
            MipCount);

        float MipLevel =
            Material.Roughness *
            (MipCount - 1);

        float3 PrefilteredSpecular =
            IBLSpecularMap.SampleLevel(
                LinearClampSampler,
                R,
                MipLevel).rgb;

        //---------------------------------
        // Sample BRDF LUT
        //---------------------------------

        float2 BRDF =
            IBLLut.Sample(
                LinearClampSampler,
                float2(
                    NdotV,
                    Material.Roughness)).rg;

        //---------------------------------
        // Evaluate IBL
        //---------------------------------

        Result +=
            ShadeIBL(
                Context,
                Material,
                DiffuseIrradiance,
                PrefilteredSpecular,
                BRDF);
    }



    // AO
    Result *=
        Material.AmbientOcclusion;

    // Emissive
    Result +=
        Material.EmissiveColor;

    return Result;
}