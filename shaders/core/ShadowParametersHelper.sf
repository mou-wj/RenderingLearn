#include "/Generated/ShaderParameters/SceneLightShadowParameters.sf"
#include "/core/GlobalDefine.sf"
#ifndef SHADOW_BIAS
#define SHADOW_BIAS 0.0005
#endif

#ifndef SHADOW_FILTER_RADIUS
#define SHADOW_FILTER_RADIUS 1
#endif

#define SHADOW_TYPE_NONE         0
#define SHADOW_TYPE_DIRECTIONAL  1
#define SHADOW_TYPE_SPOT         2
#define SHADOW_TYPE_POINT        3

//==========================================================
// Common
//==========================================================

float2 ClipToUV(float2 clipXY,float2 clipScale,float2 clipBias)
{
    return clipXY * clipScale + clipBias;
}

//==========================================================
// Spot (使用固定的 LightShadowAtlas 纹理)
//==========================================================

float ShadowPCF_Spot(float2 uv, float compareDepth)
{
    uint width;
    uint height;
    // 
    LightShadowAtlas.GetDimensions(width, height);

    float2 texelSize = 1.0 / float2(width, height);
    float visibility = 0.0;
    float sampleCount = 0.0;

    [unroll]
    for (int y = -SHADOW_FILTER_RADIUS; y <= SHADOW_FILTER_RADIUS; y++)
    {
        [unroll]
        for (int x = -SHADOW_FILTER_RADIUS; x <= SHADOW_FILTER_RADIUS; x++)
        {
            float2 sampleUV = uv + float2(x, y) * texelSize;

            float shadowDepth = LightShadowAtlas.SampleLevel(
                LinearClampSampler,
                sampleUV,
                0).r;

            visibility += (compareDepth - SHADOW_BIAS <= shadowDepth) ? 1.0 : 0.0;
            sampleCount += 1.0;
        }
    }

    return visibility / sampleCount;
}

//==========================================================
// Directional (通过索引从数组中采样)
//==========================================================

float ShadowPCF_Directional(uint texIndex, float2 uv, float compareDepth)
{
    uint width;
    uint height;
    uint array;
    // 
    ParrallelLightShadows[texIndex].GetDimensions(width, height,array);

    float2 texelSize = 1.0 / float2(width, height);
    float visibility = 0.0;
    float sampleCount = 0.0;

    [unroll]
    for (int y = -SHADOW_FILTER_RADIUS; y <= SHADOW_FILTER_RADIUS; y++)
    {
        [unroll]
        for (int x = -SHADOW_FILTER_RADIUS; x <= SHADOW_FILTER_RADIUS; x++)
        {
            float2 sampleUV = uv + float2(x, y) * texelSize;
            float3 sampleUVArray = float3(sampleUV.x,sampleUV.y, (float)0);

            float shadowDepth = ParrallelLightShadows[texIndex].SampleLevel(
                LinearClampSampler,
                sampleUVArray,
                0).r;

            visibility += (compareDepth - SHADOW_BIAS <= shadowDepth) ? 1.0 : 0.0;
            sampleCount += 1.0;
        }
    }

    return visibility / sampleCount;
}

//==========================================================
// Point (Cube 采样)
//==========================================================

float ShadowPCF_Cube(uint texIndex, float3 direction, float compareDepth)
{
    // 
    float shadowDepth = PointLightShadows[texIndex].SampleLevel(
        LinearClampSampler,
        direction,
        0).r;

    return (compareDepth - SHADOW_BIAS <= shadowDepth) ? 1.0 : 0.0;
}

//==========================================================
// Spot Compute
//==========================================================

float ComputeSpotShadow(
    uint lightIndex,
    float3 worldPos)
{
    LightShadowAccessInfo access = LightShadowInfos[lightIndex];
    AtlasShadowTextureAccessInfo atlas = AtlasTextureInfos[access.ShadowInfoIndex];

    float4 shadowPos = mul(atlas.ViewProj, float4(worldPos, 1.0));
    shadowPos.xyz /= shadowPos.w;

    float2 uv = ClipToUV(shadowPos.xy,NDCToShadowUVScaleBias.xy,NDCToShadowUVScaleBias.wz);
    uv = uv * atlas.UVScale + atlas.UVBias;

    if (any(uv < 0.0) || any(uv > 1.0))
    {
        return 1.0;
    }

    float depth = shadowPos.z;

    //
    return ShadowPCF_Spot(uv, depth);
}

//==========================================================
// Directional Compute
//==========================================================

float ComputeDirectionalShadow(
    uint lightIndex,
    float3 worldPos,
    float cameraDepth)
{
    LightShadowAccessInfo access = LightShadowInfos[lightIndex];
    uint cascade = 0;
    [loop]
    for (; cascade < access.CascadeCount; ++cascade)
    {
        if(SplitBuffer[cascade] <= cameraDepth && SplitBuffer[cascade+1] >= cameraDepth){
            break;
        }
    }
    uint globalTexIndex = access.ShadowTextureIndex + cascade;

    float4 shadowPos = mul(DirectionalLightViewInfos[access.ShadowInfoIndex + cascade].ViewProj, float4(worldPos, 1.0));

    shadowPos.xyz /= shadowPos.w;
    float2 uv = ClipToUV(shadowPos.xy,NDCToShadowUVScaleBias.xy,NDCToShadowUVScaleBias.wz);

    if (any(uv < 0.0) || any(uv > 1.0))
    {
        return 1.0;
    }

    // 
    return ShadowPCF_Directional(globalTexIndex, uv, shadowPos.z);
}

//==========================================================
// Point Compute
//==========================================================

float ComputePointShadow(
    uint lightIndex,
    float3 worldPos,
    float3 lightPos,
    float radius)
{
    LightShadowAccessInfo access = LightShadowInfos[lightIndex];

    float3 dir = worldPos - lightPos;
    dir = normalize(dir);

    float depth = distance(worldPos,lightPos);

    //
    return ShadowPCF_Cube(access.ShadowTextureIndex, dir, depth);
}

//==========================================================
// Unified Interface
//==========================================================

float ComputeShadowVisibility(
    uint lightIndex,
    float3 worldPos,
    float cameraDepth,
    float3 lightPosition,
    float pointLightRadius)
{
    LightShadowAccessInfo access = LightShadowInfos[lightIndex];

    switch(access.ShadowType)
    {
    case SHADOW_TYPE_SPOT:
        return ComputeSpotShadow(lightIndex, worldPos);

    case SHADOW_TYPE_DIRECTIONAL:
        return ComputeDirectionalShadow(lightIndex, worldPos, cameraDepth);

    case SHADOW_TYPE_POINT:
        return ComputePointShadow(lightIndex, worldPos, lightPosition, pointLightRadius);

    default:
        return 1.0;
    }
}